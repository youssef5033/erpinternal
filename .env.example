# ---- Core -------------------------------------------------------------
# PostgreSQL connection string (production and demo MUST use different databases)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agency_erp
# "production" | "demo" | "development". Demo shows a persistent banner and allows reset/seed.
APP_ENV=development
# Public base URL of the app (used for auth callbacks and cookie security)
BETTER_AUTH_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 32`. Signs sessions.
BETTER_AUTH_SECRET=
# 32 random bytes base64 (`openssl rand -base64 32`). Encrypts integration credentials at rest (AES-256-GCM).
CREDENTIALS_ENCRYPTION_KEY=

# ---- Private document storage ----------------------------------------
# "local" stores files under STORAGE_LOCAL_DIR (outside /public; served only via authorised route)
# "s3" uses any S3-compatible private bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Max upload size in megabytes
UPLOAD_MAX_MB=15

# ---- Background jobs --------------------------------------------------
# The worker (`npm run worker`) uses DATABASE_URL and pg-boss. Set to "false" to disable schedules.
JOBS_ENABLED=true

# ---- Optional AI assistance ------------------------------------------
# Leave empty to run without AI. The CRM is fully functional without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Seeding ---------------------------------------------------------
# Password given to demo users created by `npm run db:seed` (demo only)
DEMO_PASSWORD=demo-password-2026
